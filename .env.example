# TimescaleDB (application database)
DATABASE_URL=postgresql://pgvitals:pgvitals_dev@localhost:5432/pgvitals

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Collector
COLLECTOR_PORT=3001
POLLING_INTERVAL_MS=10000

# Web App
NEXT_PUBLIC_API_URL=http://localhost:3001

# Encryption key for connection strings (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=replace_with_64_char_hex_string

# Clerk Auth (optional — leave empty for dev mode without auth)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stripe Billing (optional — leave empty to disable billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
