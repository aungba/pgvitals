{
  "name": "pgvitals",
  "private": true,
  "scripts": {
    "dev:collector": "pnpm --filter @pgvitals/collector dev",
    "dev:web": "pnpm --filter @pgvitals/web dev",
    "dev": "pnpm --parallel --filter @pgvitals/collector --filter @pgvitals/web dev",
    "db:generate": "pnpm --filter @pgvitals/db generate",
    "db:migrate": "pnpm --filter @pgvitals/db migrate",
    "db:seed": "pnpm --filter @pgvitals/db seed",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
